# Sabir Hotel WhatsApp Bot + Calling Agent — .env template
# Copy this file to ".env" and fill in your real values.
# NEVER commit .env, and never share it. The WhatsApp bot and the
# calling agent share this file; no secrets or phone numbers are in
# the .py files themselves.

# --- Twilio (WhatsApp) ---
# From your Twilio console. The sandbox number in the old code is only for testing;
# for real customers use a proper WhatsApp sender number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+1"

# --- Twilio Voice (calling agent) ---
# Voice number for inbound calls, e.g. "+1..." — Twilio console > Phone Numbers.
# In Twilio, set this number's Voice webhook to: <SERVER_URL>/voice
# The calling agent reads the menu + delivery charge from
# sabir_hotel_config.json, same as the WhatsApp bot. Delivery charge
# lives in the JSON, not here.
TWILIO_VOICE_NUMBER=""

# --- Gemini (order parsing — items + quantities only; prices come from MENU in sabir_hotel_config.json) ---
GEMINI_API_KEY=""

# --- Sabir Hotel numbers (WhatsApp format, with country code) ---
KITCHEN_WHATSAPP="whatsapp:+92"
OWNER_WHATSAPP="whatsapp:+92"

# --- Server ---
# Public HTTPS domain where the bot runs, e.g. https://your-domain.com
# In Twilio, set the WhatsApp webhook to: <SERVER_URL>/whatsapp
SERVER_URL="https://your-domain.com"

# --- Delivery ---
# Delivery charge lives in sabir_hotel_config.json (delivery_charge_pkr).
# Do NOT set FIXED_DELIVERY_CHARGE here unless you want .env to override
# the JSON — the old template set it to 150, which silently ignored any
# delivery charge changed in the JSON. If /settings ever saves a delivery
# charge, it writes FIXED_DELIVERY_CHARGE here and that value wins after restart.
# FIXED_DELIVERY_CHARGE=150

# --- Admin login for /settings ---
# Choose a strong password. If ADMIN_PASSWORD is empty, /settings will not work.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=""

# --- Google Sheets (Railway fix, 2026-11-07) ---
# Railway has no way to upload a credentials.json file, so paste the WHOLE
# contents of your Google service-account credentials.json file here, as
# one value (keep its newlines — JSON with line breaks is fine). Both bots
# read it from here first; the credentials.json file is only a fallback
# for running on your own PC. Never commit this value. Share the
# "Sabir Hotel" Google Sheet with that service account's email.
GOOGLE_CREDENTIALS_JSON=""

# --- Also needed, but NOT in this file ---
# 1. credentials.json — Google service account file, in the same folder as
#    the bot (only needed when running on your own PC; on Railway use
#    GOOGLE_CREDENTIALS_JSON above instead).
#    Share the "Sabir Hotel" Google Sheet with that service account's email.
# 2. MENU in sabir_hotel_config.json — replace the example prices with
#    Sabir Hotel's real item names and PKR prices before going live.
#    The bot does NOT read whatsapp_numbers / server_url from that JSON;
#    those go in this .env file only.
